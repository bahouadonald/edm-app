{
  "expo": {
    "name": "EDM",
    "slug": "edm-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/edm-icon.png",
    "scheme": "edmmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/edm-icon.png"
    },
    "android": {
      "package": "com.edm.ecdv",
      "adaptiveIcon": {
        "backgroundColor": "#FDF8F0",
        "foregroundImage": "./assets/images/edm-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/edm-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF8F0",
          "image": "./assets/images/edm-logo.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EDM a besoin d'accéder à tes photos pour choisir ta photo de profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "92664b48-f37e-4e5a-bf85-20a3c4479197"
      }
    },
    "owner": "bdonald777"
  }
}
