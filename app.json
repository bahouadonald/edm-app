{
  "expo": {
    "name": "Élite Doniel Ministries",
    "slug": "edm-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/edm-logo.png",
    "scheme": "edmmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/edm-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF8F0",
        "foregroundImage": "./assets/images/edm-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/edm-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF8F0",
          "image": "./assets/images/edm-logo.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
